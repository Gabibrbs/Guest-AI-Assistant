# Copia este ficheiro para .env e põe lá a tua chave. O .env nunca vai para o GitHub.
GEMINI_API_KEY=a_tua_chave_aqui
GEMINI_MODEL=gemini-3.5-flash
# Chave que assina o cookie da sessão (uma por instalação, nunca partilhada). Gera uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=uma_chave_longa_e_aleatoria
