# Copia este ficheiro para .env e põe lá a tua chave. O .env nunca vai para o GitHub.
GEMINI_API_KEY=a_tua_chave_aqui
# Modelo principal e modelo de reserva (usado uma vez se o principal estiver ocupado; none = sem reserva)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Chave que assina o cookie da sessão (uma por instalação, nunca partilhada). Gera uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=uma_chave_longa_e_aleatoria
# Hash da palavra-passe do anfitrião (a palavra-passe nunca fica guardada). Gera a linha com:
#   python set_host_password.py
HOST_PASSWORD_HASH='scrypt:32768:8:1$...$...'
# Limites de perguntas (para a conta do Gemini não ter surpresas). Por defeito: 20 e 200.
GUEST_QUESTIONS_PER_HOUR=20
QUESTIONS_PER_DAY=200
# Pasta com config.toml e os dados do cliente (por defeito: dados). Cria-a a partir da demo:
#   Copy-Item -Recurse exemplo dados
DATA_FOLDER=dados
# Endereço público da app (sem / no fim). Os QR codes apontam para aqui; sem ele, não se geram.
PUBLIC_BASE_URL=https://a_tua_conta.pythonanywhere.com
